# OneAuth 部署环境变量

# 安装目录
INSTALL_DIR=/opt/oneauth

# 数据库
DB_NAME=sso_platform
DB_USER=sso
DB_PASSWORD=Password123@sqlite

# Redis
REDIS_PASSWORD=Password123@redis

# SSO 平台对外地址（用于 OIDC issuer 与回调）
SSO_ISSUER=http://localhost
# 可信反向代理 IP/CIDR，逗号分隔；填代理所在网段，不要填访问者 IP
SSO_TRUSTED_PROXIES=
SECRET_KEY=oneauth-secret-key-default
